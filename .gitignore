# --- Deny All ---
*

# --- Whitelist Directories to Allow Recursion ---
!*/

# --- Whitelist Allowed Extensions ---
!*.py
!*.sh
!*.ps1
!*.md
!*.txt
!*.html

# --- Allow Config Files ---
!.gitignore
!requirements.txt

# --- Explicitly Re-Ignore Build/Env/Data Directories ---
# (To prevent tracking venv, caches, and generated data)
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Ignore Secrets & Local Config ---
.env

# --- Ignore Project Data & Logs ---
awr-rag/data/
awr-rag/logs/
awr-rag/outputs/
qdrant_data/
.agent/
.git/
.vscode/
.idea/
.DS_Store
awr_chunks.json
awr-rag/data/processed/awr_chunks.json
awr-rag/data/processed/awr_chunks.json
